#!/bin/bash
# Run claude / codex / a shell inside the docker sandbox.
#   sbx <tool> [--local] [project-dir] [tool args...]
# tool: claude | codex | shell | seed | rebuild | stop | ps | git
# --local: profile "local" for this call (internal model server only, README).
set -euo pipefail

# Portable helpers (Linux and macOS: no GNU-only options, bash 3.2 compatible).
abspath() { # absolute, symlink-resolved path of an existing dir or file; fails otherwise
    if [ -d "$1" ]; then (cd "$1" 2>/dev/null && pwd -P)
    elif [ -e "$1" ]; then (cd "$(dirname "$1")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")")
    else return 1
    fi
}
hash16() { # first 16 hex chars of sha256 of stdin
    if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -c1-16
}

SANDBOX_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")" && pwd -P)"
tool="${1:?usage: sbx <claude|codex|shell|seed|rebuild|stop|ps|git> [--local] [project-dir] [args...]}"
force_seed=0
shift
profile_flag=""
if [ "${1:-}" = "--local" ]; then profile_flag=local; shift; fi

if [ $# -gt 0 ] && [ -d "$1" ]; then
    project="$(abspath "$1")"; shift
else
    project="$(abspath "$PWD")"
fi
export SANDBOX_PROJECT="$project"

# Host-side review of git remote operations requested from inside (no docker needed).
if [ "$tool" = git ]; then
    exec python3 "$SANDBOX_DIR/sbx-git.py" --project "$project" "$@"
fi

if ! docker info >/dev/null 2>&1; then
    if [ -S /var/run/docker.sock ] && ! [ -w /var/run/docker.sock ]; then
        echo "sbx: no access to docker socket. You are in the docker group but this" >&2
        echo "     shell predates it: run 'newgrp docker' or log out and back in." >&2
    else
        echo "sbx: docker daemon not reachable (is docker.service running?)" >&2
    fi
    exit 1
fi

if [ "$tool" = ps ]; then
    exec docker ps -a --filter label=sbx.project \
        --format 'table {{.ID}}\t{{.Status}}\t{{.Label "sbx.project"}}'
fi

# One container per project directory. Label keys the lookup so different
# projects never share a container (and its bind mount).
label="sbx.project=$project"

# Per-project host-side config. It lives OUTSIDE the project so the agent,
# which has write access to the project, cannot widen its own mounts or
# egress (a cloned repo could otherwise ship such a file):
#   ~/.config/sbx/projects/<project path, "/" -> "-">/mounts   extra bind mounts
#   ~/.config/sbx/projects/<...>/allow                          extra egress domains
# The directory is bind-mounted read-only at /etc/sbx so the firewall can read
# "allow" without trusting anything the container user can write.
cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/sbx/projects/${project//\//-}"
for legacy in .sandbox-mounts .sandbox-allow; do
    if [ -e "$project/$legacy" ]; then
        echo "sbx: ignoring $project/$legacy: files inside the project are writable by the agent." >&2
        echo "     Move it to $cfg_dir/${legacy#.sandbox-}" >&2
    fi
done

# Extra bind mounts: one host path per line in $cfg_dir/mounts (append :ro
# for read-only), plus whitespace-separated SBX_MOUNTS="/a /b:ro". Mounted at
# the same absolute path inside the container. A change in the list recreates
# the container, since mounts are fixed at creation.
extra_mounts=()
rw_roots=("$project")
mount_spec=""
add_mount() {
    local entry="$1" ro="" src
    [[ "$entry" == *:ro ]] && { ro=",readonly"; entry="${entry%:ro}"; }
    entry="${entry/#\~/$HOME}"
    [ -z "$entry" ] && return
    if ! src="$(abspath "$entry")"; then
        echo "sbx: mount path not found: $entry" >&2; exit 1
    fi
    extra_mounts+=("source=$src,target=$src,type=bind$ro")
    [ -z "$ro" ] && rw_roots+=("$src")
    mount_spec+="$src$ro;"
}
if [ -f "$cfg_dir/mounts" ]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        add_mount "$line"
    done < "$cfg_dir/mounts"
fi
if [ -n "${SBX_MOUNTS:-}" ]; then
    for m in $SBX_MOUNTS; do add_mount "$m"; done
fi
# Git approval queue (see README, "Git: remote operations run on the host").
# The container writes requests into $req_dir (read-write); the host validates
# and runs them with sbx-git. The project path the validation relies on is
# stored one level up, outside the mount, so the agent cannot rewrite it.
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/sbx"
state_dir="$state_root/projects/${project//\//-}"
req_dir="$state_dir/requests"
# Neither the config dir nor the state dir may be writable from inside the
# container, or the agent could edit its own allowlist or project path.
for root in "${rw_roots[@]}"; do
    for d in "$cfg_dir" "$state_dir"; do
        case "$d/" in "$root"/*)
            echo "sbx: refusing: $d lies inside the writable mount $root" >&2
            echo "     Mount that directory read-only (:ro) or set XDG_CONFIG_HOME / XDG_STATE_HOME elsewhere." >&2
            exit 1 ;;
        esac
    done
done
# Profile: "cloud" (default) or "local" (internal model server only; README,
# "Profile local"). A project profile file wins over the default, --local
# forces local for this call, and nothing can force a local project to cloud.
profile=cloud
if [ -f "$cfg_dir/profile" ]; then
    profile="$(tr -d '[:space:]' < "$cfg_dir/profile")"
fi
[ "$profile_flag" = local ] && profile=local
case "$profile" in
    cloud|local) ;;
    *) echo "sbx: unknown profile '$profile' in $cfg_dir/profile (expected cloud or local)" >&2; exit 1 ;;
esac
local_spec=""
SBX_LOCAL_BASE_URL=""; SBX_LOCAL_MODEL=""; SBX_LOCAL_API_KEY=""; SBX_LOCAL_CONTEXT_TOKENS=""; local_host=""
if [ "$profile" = local ]; then
    env_file="${XDG_CONFIG_HOME:-$HOME/.config}/sbx/local-model.env"
    if [ ! -f "$env_file" ]; then
        echo "sbx: profile local needs $env_file" >&2
        echo "     Template: $SANDBOX_DIR/local-model.env.example" >&2
        exit 1
    fi
    # KEY=VALUE lines; parsed, not sourced.
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
        [ -z "$line" ] && continue
        case "$line" in
            SBX_LOCAL_BASE_URL=*) SBX_LOCAL_BASE_URL="${line#*=}" ;;
            SBX_LOCAL_MODEL=*)    SBX_LOCAL_MODEL="${line#*=}" ;;
            SBX_LOCAL_API_KEY=*)  SBX_LOCAL_API_KEY="${line#*=}" ;;
            SBX_LOCAL_CONTEXT_TOKENS=*) SBX_LOCAL_CONTEXT_TOKENS="${line#*=}" ;;
            *) echo "sbx: ignoring unknown line in $env_file: ${line%%=*}" >&2 ;;
        esac
    done < "$env_file"
    if [ -n "$SBX_LOCAL_CONTEXT_TOKENS" ] && [[ ! "$SBX_LOCAL_CONTEXT_TOKENS" =~ ^[0-9]+$ ]]; then
        echo "sbx: SBX_LOCAL_CONTEXT_TOKENS must be a number, got '$SBX_LOCAL_CONTEXT_TOKENS'" >&2
        exit 1
    fi
    if [[ ! "$SBX_LOCAL_BASE_URL" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?/?$ ]]; then
        echo "sbx: SBX_LOCAL_BASE_URL must be http(s)://host[:port] without a path, got '$SBX_LOCAL_BASE_URL'" >&2
        exit 1
    fi
    SBX_LOCAL_BASE_URL="${SBX_LOCAL_BASE_URL%/}"
    if [ -z "$SBX_LOCAL_MODEL" ] || [[ "$SBX_LOCAL_MODEL" == *"<<"* ]]; then
        echo "sbx: SBX_LOCAL_MODEL is missing or still a placeholder in $env_file" >&2
        exit 1
    fi
    local_host="$(printf '%s' "$SBX_LOCAL_BASE_URL" | sed -E 's#^https?://([^/:]+).*#\1#')"
    [ -n "$SBX_LOCAL_API_KEY" ] || SBX_LOCAL_API_KEY=local
    local_spec="$SBX_LOCAL_BASE_URL|$SBX_LOCAL_MODEL"
fi
export SBX_GEN_PROFILE="$profile" SBX_LOCAL_BASE_URL SBX_LOCAL_MODEL SBX_LOCAL_API_KEY SBX_LOCAL_CONTEXT_TOKENS

# /etc/sbx: generated on the host at every start and mounted read-only. The
# firewall reads profile, allowlist and (local) model host from here; the
# codex config for the local provider is copied into the volume from here.
# The API key stays out of this dir; it travels as container env only.
etc_dir="$state_dir/etc-sbx"
mkdir -p "$etc_dir"
rm -f "$etc_dir/profile" "$etc_dir/allow" "$etc_dir/local-model.env"; rm -rf "$etc_dir/codex"
printf '%s\n' "$profile" > "$etc_dir/profile"
[ -f "$cfg_dir/allow" ] && cp "$cfg_dir/allow" "$etc_dir/allow"
if [ "$profile" = local ]; then
    printf 'SBX_LOCAL_HOST=%s\nSBX_LOCAL_BASE_URL=%s\nSBX_LOCAL_MODEL=%s\n' \
        "$local_host" "$SBX_LOCAL_BASE_URL" "$SBX_LOCAL_MODEL" > "$etc_dir/local-model.env"
    mkdir -p "$etc_dir/codex"
    cat > "$etc_dir/codex/config.toml" <<EOF
# Generated by sbx for profile "local" from ~/.config/sbx/local-model.env.
# Copied into ~/.codex at every start; edit the env file, not this copy.
# Limits follow ki-leitfaden konfiguration/codex-cli/config.toml.
model_provider = "local"
model = "$SBX_LOCAL_MODEL"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "disabled"
check_for_update_on_startup = false
project_doc_max_bytes = 32768

[analytics]
enabled = false

[feedback]
enabled = false

[sandbox_workspace_write]
network_access = false
writable_roots = []
exclude_tmpdir_env_var = false
exclude_slash_tmp = false

[shell_environment_policy]
inherit = "all"
ignore_default_excludes = false

[shell_environment_policy.filters]
"AWS_*" = "exclude"
"*PASSWORD*" = "exclude"
"*PASSWD*" = "exclude"
"*CREDENTIAL*" = "exclude"
"GITHUB_*" = "exclude"
"NPM_TOKEN" = "exclude"
"SBX_LOCAL_API_KEY" = "exclude"
"ANTHROPIC_*" = "exclude"

[model_providers.local]
name = "Interner Inferenzserver"
base_url = "$SBX_LOCAL_BASE_URL/v1"
env_key = "SBX_LOCAL_API_KEY"
wire_api = "responses"
EOF
fi
extra_mounts+=("source=$etc_dir,target=/etc/sbx,type=bind,readonly")
mount_spec+="/etc/sbx;"
mkdir -p "$req_dir/done" "$req_dir/rejected"
printf '%s\n' "$project" > "$state_dir/project"
extra_mounts+=("source=$req_dir,target=/run/sbx/requests,type=bind")
mount_spec+="/run/sbx/requests;"
# Config volumes (~/.claude, ~/.codex, bash history) are per project: a
# repository that turns the agent against its user must not read the session
# history or settings of other projects, and the seeded login is confined to
# the container of the project it was seeded for. Profile local gets its own
# set, into which no cloud credentials are ever copied.
volume_suffix="$(printf '%s' "$project" | hash16)"
[ "$profile" = local ] && volume_suffix="local-$volume_suffix"
export SBX_GEN_VOLUME_SUFFIX="$volume_suffix"
# Config layout version; bump to force recreation of existing containers.
# Profile and endpoint are part of the hash: a change recreates the container.
mounts_hash="$(printf 'v6;%s;%s;%s' "$mount_spec" "$profile" "$local_spec" | hash16)"
mounts_label="sbx.mounts=$mounts_hash"

# The devcontainer CLI's --mount flag cannot express readonly, but the
# "mounts" field in devcontainer.json can. Generate a config with the extra
# mounts appended, next to the base one so "build.dockerfile" still resolves.
config="$SANDBOX_DIR/.devcontainer/devcontainer.json"
if [ ${#extra_mounts[@]} -gt 0 ]; then
    mkdir -p "$SANDBOX_DIR/.devcontainer/gen/$mounts_hash"
    config="$SANDBOX_DIR/.devcontainer/gen/$mounts_hash/devcontainer.json"
    python3 - "$SANDBOX_DIR/.devcontainer/devcontainer.json" "$config" "${extra_mounts[@]}" <<'PY'
import json, os, re, sys
base, out, *extra = sys.argv[1:]
d = json.load(open(base))
d["build"] = {"dockerfile": "../../Dockerfile", "context": "../.."}
d.setdefault("mounts", []).extend(extra)
suffix = os.environ["SBX_GEN_VOLUME_SUFFIX"]
d["mounts"] = [re.sub(r"^source=(sandbox-[a-z-]+),", rf"source=\1-{suffix},", m) for m in d["mounts"]]
if os.environ.get("SBX_GEN_PROFILE") == "local":
    model = os.environ["SBX_LOCAL_MODEL"]
    key = os.environ["SBX_LOCAL_API_KEY"]
    d.setdefault("containerEnv", {}).update({
        "SBX_PROFILE": "local",
        # Claude Code -> internal server (Anthropic Messages API), every alias pinned
        "ANTHROPIC_BASE_URL": os.environ["SBX_LOCAL_BASE_URL"],
        "ANTHROPIC_AUTH_TOKEN": key,
        "ANTHROPIC_MODEL": model,
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
        "ANTHROPIC_DEFAULT_FABLE_MODEL": model,
        "ANTHROPIC_SMALL_FAST_MODEL": model,
        # no side traffic: telemetry, error reports, updater, claude.ai connectors
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
        "DISABLE_AUTOUPDATER": "1",
        "DISABLE_TELEMETRY": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
        # Codex reads the key through env_key in config.toml
        "SBX_LOCAL_API_KEY": key,
    })
    # Unknown to Claude Code's model catalog: tell it the real context window,
    # otherwise it assumes 200k and compacts accordingly.
    if os.environ.get("SBX_LOCAL_CONTEXT_TOKENS"):
        d["containerEnv"]["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = os.environ["SBX_LOCAL_CONTEXT_TOKENS"]
json.dump(d, open(out, "w"), indent=2)
PY
fi

dc=(devcontainer --workspace-folder "$SANDBOX_DIR" --config "$config" \
    --id-label "$label" --id-label "$mounts_label")

case "$tool" in
    rebuild)
        "${dc[@]}" up --remove-existing-container --build-no-cache
        exit 0
        ;;
    stop)
        id=$(docker ps -aq --filter "label=$label")
        [ -n "$id" ] && docker rm -f "$id" >/dev/null && echo "stopped $id"
        exit 0
        ;;
    shell) cmd=(bash -l "$@") ;;
    seed) force_seed=1; cmd=(true) ;;
    claude|codex) cmd=("$tool" "$@") ;;
    *) echo "unknown tool: $tool" >&2; exit 2 ;;
esac

# Existing container for this project with a different mount set: replace it.
for c in $(docker ps -aq --filter "label=$label"); do
    have=$(docker inspect -f '{{index .Config.Labels "sbx.mounts"}}' "$c")
    if [ "$have" != "$mounts_hash" ]; then
        echo "sbx: config changed, recreating container" >&2
        docker rm -f "$c" >/dev/null
    fi
done

# devcontainer up logs the docker build to stderr every time; keep it quiet
# unless it fails.
log="$(mktemp)"
if ! "${dc[@]}" up >"$log" 2>&1; then
    cat "$log" >&2; rm -f "$log"
    echo "sbx: devcontainer up failed" >&2; exit 1
fi
rm -f "$log"
# devcontainer exec cannot pass dash-prefixed args (yargs eats them), so exec
# via docker directly. Container env (CLAUDE_CONFIG_DIR etc.) is baked in.
id=$(docker ps -q --filter "label=$label" --filter "label=$mounts_label" | head -n1)
[ -n "$id" ] || { echo "sbx: container not found for $project" >&2; exit 1; }
# Approval web UI on the host, loopback only; start it unless something listens.
# SBX_WEB=0 disables the autostart (sbx-git --serve runs it by hand).
if [ "${SBX_WEB:-1}" = 1 ] && ! (exec 3<>/dev/tcp/127.0.0.1/7331) 2>/dev/null; then
    nohup python3 "$SANDBOX_DIR/sbx-git.py" --serve >>"$state_root/web.log" 2>&1 &
    disown
fi
n_pending=$(find "$req_dir" -maxdepth 1 -name '*.req' | wc -l)
if [ "$n_pending" -gt 0 ]; then
    echo "sbx: $n_pending git request(s) pending for this project: sbx-git or http://127.0.0.1:7331/" >&2
fi
# First use of a fresh config volume: copy portable config (and, cloud only,
# auth) from the host. seed-config.sh leaves a marker in the volume.
if [ "$force_seed" = 1 ] || ! docker exec -u dev "$id" test -f /home/dev/.claude/.sbx-seeded; then
    "$SANDBOX_DIR/seed-config.sh" "$id" "$profile"
    [ "$tool" = seed ] && exit 0
fi
# Local profile: codex provider config is regenerated on the host every start.
if [ "$profile" = local ]; then
    docker exec -u dev "$id" sh -c 'mkdir -p /home/dev/.codex && cp /etc/sbx/codex/config.toml /home/dev/.codex/config.toml'
fi
tty_flag=""; [ -t 0 ] && tty_flag="-t"
# exec so the terminal's foreground process is "docker": Ptyxis keys its
# window colouring (.container class) off that name.
exec docker exec -i $tty_flag -u dev -w "$project" \
    -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" \
    "$id" "${cmd[@]}"
