# Endpoint of the internal inference server for the sandbox profile "local".
# Copy to ~/.config/sbx/local-model.env and fill in. KEY=VALUE lines, no quotes
# needed, "#" starts a comment. Never put this file into a project.
#
# Base URL without a path: Claude Code appends /v1/messages, Codex gets
# <BASE_URL>/v1 as OpenAI-compatible base. The server must offer the Anthropic
# Messages API and the OpenAI Responses API (Ollama and LiteLLM do).
SBX_LOCAL_BASE_URL=https://<<INFERENZSERVER>>:8443
# Model name as the server knows it; used for every model alias of both harnesses.
SBX_LOCAL_MODEL=<<MODELLNAME>>
# Optional. Sent as bearer token by Claude Code and via env_key by Codex. It
# reaches the container as an environment variable, so it must only be valid
# for the internal server. Leave empty if the server needs none.
SBX_LOCAL_API_KEY=
# Optional. Context window of the model in tokens (llama.cpp: "n_ctx" in
# GET <BASE_URL>/v1/models). Claude Code does not know local models and would
# otherwise assume 200k and compact too early or too late.
SBX_LOCAL_CONTEXT_TOKENS=
